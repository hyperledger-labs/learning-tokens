        "prettier": "^3.9.6",
        "source-map-support": "^0.5.20",
        "supertest": "^7.2.2",
        "ts-jest": "29.4.12",
        "ts-loader": "^9.2.3",
        "ts-node": "^10.0.0",
        "tsconfig-paths": "4.2.0",
